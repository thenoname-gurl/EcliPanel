---
import PageShell from "../../components/PageShell";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageData } from "../../lib/page-data";
const { locale, messages, initialUser, pathname } = await getPageData(Astro.cookies, Astro.request.headers, Astro.url.pathname);
const { id } = Astro.params;
const siteUrl = (process.env.SITE_URL || "https://ecli.app");
const backendUrl = ((process.env.BACKEND_URL || "") || (process.env.PUBLIC_API_BASE || "") || "").replace(/\/+$/, "");
let title = `Contributor — EclipseSystems`, description = "";
let ogImage = `${siteUrl}/contributors/${id}/og.png`;
try {
  const res = await fetch(`${backendUrl}/public/contributors`);
  if (res.ok) {
    const data = await res.json();
    const list = Array.isArray(data?.contributors) ? data.contributors : [];
    const c = list.find((x: any) => String(x.login || "").toLowerCase() === String(id || "").toLowerCase()) ?? null;
    if (c) { title = `${c.displayName || c.login} — Contributors — EclipseSystems`; description = c.title || c.bio || ""; }
  }
} catch {}
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogType="profile">
  <PageShell client:load="react" locale={locale} messages={messages} initialUser={initialUser} page="app" pathname={pathname} />
  <script id="__astro_params" type="application/json">{JSON.stringify({ id })}</script>
</BaseLayout>
