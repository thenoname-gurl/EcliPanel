---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageShell from "../../components/PageShell";
import { getPageData } from "../../lib/page-data";

const { locale, messages, initialUser, pathname } = await getPageData(
  Astro.cookies,
  Astro.request.headers,
  Astro.url.pathname,
);

const cookieHeader = Astro.request.headers.get("cookie") || "";
const BACKEND_URL = (import.meta.env.BACKEND_URL || import.meta.env.PUBLIC_API_BASE || "").replace(/\/+$/, "");

let eloPrefetch: any = null;

if (cookieHeader && BACKEND_URL && initialUser) {
  try {
    const res = await fetch(`${BACKEND_URL}/api/elo/my`, { headers: { cookie: cookieHeader } });
    if (res.ok) {
      eloPrefetch = await res.json();
    }
  } catch { /* sob */ }
}
---

<BaseLayout>
  <PageShell
    client:load="react"
    locale={locale}
    messages={messages}
    initialUser={initialUser}
    page="app"
    pathname={pathname}
  />
  {eloPrefetch && <script id="__elo_data" type="application/json">{JSON.stringify(eloPrefetch)}</script>}
</BaseLayout>