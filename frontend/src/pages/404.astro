---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell";
import { getPageData } from "../lib/page-data";

const { locale, messages, initialUser } = await getPageData(
  Astro.cookies, Astro.request.headers, Astro.url.pathname
);
---

<BaseLayout title="Page Not Found — EclipseSystems" description="This page doesn't exist, but your next deployment could.">
  <PageShell client:load="react" locale={locale} messages={messages} initialUser={initialUser} page="app" pathname={Astro.url.pathname} />
</BaseLayout>