---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell";
import { getPageData } from "../lib/page-data";

const { locale, messages, initialUser, pathname } = await getPageData(
  Astro.cookies, Astro.request.headers, Astro.url.pathname
);
---

<BaseLayout title="Geoblock Policy — EclipseSystems" description="Restricted jurisdictions and geoblock rules">
  <PageShell client:load="react" locale={locale} messages={messages} initialUser={initialUser} page="app" pathname={pathname} />
</BaseLayout>